# Copia este archivo a `.dev.vars` (NO se sube a git). Variables para `npm run dev`.
DATABASE_URL="postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Solo en local: simula el usuario logueado (en producción lo da Cloudflare Access).
DEV_AUTH_EMAIL="tu-correo@gmail.com"

# Producción (se cargan con `wrangler secret put`, aquí quedan vacíos):
# ACCESS_TEAM_DOMAIN="tu-equipo.cloudflareaccess.com"
# ACCESS_AUD="tag-de-la-aplicacion-de-access"
# GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# GOOGLE_PRIVATE_KEY=""
# SHEETS_RESPALDO_ID=""
