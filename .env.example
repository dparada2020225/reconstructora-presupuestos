# Copia este archivo a `.env` (NO se sube a git). Lo usan los scripts de Node
# (migraciones, ETL, seed). La app en Workers usa `.dev.vars` en local y
# secretos de Cloudflare en producción.

# Postgres de Neon. Para desarrollo usa la rama `dev`; para cargar datos reales, `main`.
DATABASE_URL="postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Carpeta donde están los Excel históricos (fuera del repo).
# Por defecto: la carpeta padre del repo (…/presupuestos).
DATA_DIR=".."
# Carpeta donde el ETL escribe sus resultados (fuera del repo).
ETL_OUT_DIR="../_etl"

# Usuarios iniciales de la app: email:rol:Nombre separados por ";"
# Roles: admin | editor | revisor
SEED_USUARIOS="correo1@gmail.com:admin:Nombre;correo2@gmail.com:editor:Nombre"
